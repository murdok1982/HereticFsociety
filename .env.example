# FSOCIETY AI environment example.
# Copy to .env (never commit .env) or export these variables.
# Precedence: defaults < fsociety.toml < FSOCIETY_* environment.

# Workspace for data, models, reports, exports, plugins and audit logs.
# FSOCIETY_WORKSPACE=~/.local/share/fsociety

# API (loopback by default). Non-loopback requests require an API key.
FSOCIETY_API_HOST=127.0.0.1
FSOCIETY_API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FSOCIETY_API_KEY=
# FSOCIETY_API_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# FSOCIETY_API_CORS_ORIGINS=["http://localhost:5173"]
FSOCIETY_API_RATE_LIMIT_PER_MINUTE=120

# Security
FSOCIETY_TRUST_REMOTE_CODE=never
FSOCIETY_TRUSTED_REPOSITORIES=[]
FSOCIETY_PLUGIN_ISOLATION=true
FSOCIETY_PLUGIN_ALLOW_NETWORK=false
FSOCIETY_PLUGIN_TIMEOUT_SECONDS=30

# Engine / evaluation defaults (recorded in reports)
FSOCIETY_EVALUATION_SEED=42
FSOCIETY_MAX_NEW_TOKENS=256
FSOCIETY_TEMPERATURE=0.0
FSOCIETY_OFFLINE=false

# Hugging Face token is consumed by huggingface_hub itself.
# Prefer `huggingface-cli login` or a secret manager over committing it.
# HF_TOKEN=
